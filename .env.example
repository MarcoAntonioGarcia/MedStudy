# Nombres de las variables de entorno de MedStudy. SIN valores: los valores
# reales nunca van al repositorio. Ver README.md («Variables de entorno»).
PORT=
HOST=
# Postgres (Neon). Solo en el panel de Render: la app nunca lee un .env.
DATABASE_URL=
# 1 en producción (fija en render.yaml).
MEDSTUDY_PRODUCCION=
# Zona horaria de quien estudia (por defecto America/Mexico_City).
APP_TZ=
ESTUDIO_CONTENT_DIR=
APP_URL=
APP_NOMBRE=
CORREO_MODO=
BREVO_API_KEY=
CORREO_REMITENTE=
COOKIE_SEGURA=
SECRETO_APP=
IP_DE_CABECERA=
MAX_CORREOS_DIA=
MAX_ALTAS_DIA=
DOCS=
# El primer admin en producción: la cuenta que se registre con este correo.
ADMIN_EMAIL=
# Solo crear_admin.py en local (en producción se niega a leer la contraseña).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Solo pruebas: correrlas contra un Postgres real (nunca el de producción).
TEST_PG_URL=
